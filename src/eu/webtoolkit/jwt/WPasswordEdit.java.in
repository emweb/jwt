/** 

A password edit. 
    
<p>

A password edit is a line edit where the character are hidden.

<p>
The widget corresponds to the HTML <code>&lt;input type=&quot;password&quot;&gt;</code> tag. 
    
*/
public class WPasswordEdit extends WLineEdit {
