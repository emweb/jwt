  public void setMaxLength(int length) {
  if ( length !=  this.getMaxLength()) { 
       this.pwdValidator_.setMaxLength (length);
} 
   super.setMaxLength (length);
}
  /**
  
  Changes whether a native HTML5 control is used. 
          
  <p>
  
  When enabled the browser&apos;s native attribute for password input (&lt;input type=&quot;password&quot;&gt;) will be used instead of a validator.
  
  <p>
  By default, this option is set to {@link WWebWidget#isDefaultNativeControl()}, which is <code>false</code> by default.
  
  <p>
  @see WPasswordEdit#isNativeControl()
  @see WWebWidget#setDefaultNativeControl(boolean enabled)
  
  
          
  */
  public void setNativeControl(boolean nativeControl) {
  if ( nativeControl !=   this.nativeControl_) {  
    this.nativeControl_ = nativeControl;
   this.flags_.set (BIT_CONTROL_CHANGED);
if (! nativeControl) { 
        this.getStackedValidator().addValidator (  this.pwdValidator_);
}
    else  { 
        this.getStackedValidator().removeValidator (  this.pwdValidator_);
}
  }
  }
  /**
  
  Returns whether a native HTML5 control is used. 
          
  <p>
  
  @see WPasswordEdit#setNativeControl(boolean nativeControl)
  
  
          
  */
  public boolean isNativeControl() {
  return   this.nativeControl_;
  }
  /**
  
  Sets whether the password is shown in clear text. 
          
  <p>
  
  When enabled, the input changes its type from &quot;password&quot; to &quot;text&quot;, revealing the content of the field.
  
  <p>
  The default value is false.
  
  <p>
  @see WPasswordEdit#isTextVisible()
  
  
          
  */
  public void setTextVisible(boolean visible) {
  if ( visible !=   this.textVisible_) {  
    this.textVisible_ = visible;
   this.flags_.set (BIT_TEXT_VISIBLE_CHANGED);
  this.repaint ();
}
  }
  /**
  
  Returns whether the password is shown in clear text. 
          
  <p>
  
  @see WPasswordEdit#setTextVisible(boolean visible)
  
  
          
  */
  public boolean isTextVisible() {
  return   this.textVisible_;
  }
  /**
  
  Shows or hides a button allowing the user to reveal the password. 
          
  <p>
  
  When enabled, a button is shown inside the line edit which toggles the visibility of the password. The toggle happens client-side, without a server round trip, and is reported back with {@link WPasswordEdit#textVisibilityChanged() textVisibilityChanged()}.
  
  <p>
  The default value is false.
  
  <p>
  
  <p><i><b>Note: </b>The button can only be activated with a pointer device. For a keyboard-accessible toggle, connect your own control to {@link WPasswordEdit#setTextVisible(boolean visible) setTextVisible()}.
  </i></p>
  
  
  <p><i><b>Note: </b>Hiding the button does not hide a password that is currently shown; use {@link WPasswordEdit#setTextVisible(boolean visible) setTextVisible()} for that.
  </i></p>
  
  @see WPasswordEdit#isRevealButtonEnabled()
  @see WPasswordEdit#setTextVisible(boolean visible)
  @see WPasswordEdit#textVisibilityChanged()
  
  
          
  */
  public void setRevealButtonEnabled(boolean enabled) {
  if ( enabled !=   this.revealButtonEnabled_) {  
    this.revealButtonEnabled_ = enabled;
  this.toggleStyleClass ("Wt-passwordedit-reveal", enabled);
}
  }
  /**
  
  Returns whether the reveal button is shown. 
          
  <p>
  
  @see WPasswordEdit#setRevealButtonEnabled(boolean enabled)
  
  
          
  */
  public boolean isRevealButtonEnabled() {
  return   this.revealButtonEnabled_;
  }
  /**
  
  {@link Signal} emitted when the user toggles the text visibility. 
          
  <p>
  
  This is emitted when the visibility of the password is changed with the reveal button. The argument is whether the password is now shown in clear text.
  
  <p>
  @see WPasswordEdit#setRevealButtonEnabled(boolean enabled)
  @see WPasswordEdit#isTextVisible()
  
  
          
  */
  public JSignal1<Boolean> textVisibilityChanged() {
  if (!   this.textVisibilityChangedUsed_) {  
    this.textVisibilityChangedUsed_ = true;
  this.repaint ();
}
  return   this.textVisibilityChanged_;
  }
  /**
  
  Specifies the minimum length of text that can be entered. 
          
  <p>
  
  The default value is 0. 
          
  */
  public void setMinLength(int length) {
  if ( length !=  this.getMinLength()) { 
       this.pwdValidator_.setMinLength (length);
   this.flags_.set (BIT_MIN_LENGTH_CHANGED);
  this.repaint ();
}
