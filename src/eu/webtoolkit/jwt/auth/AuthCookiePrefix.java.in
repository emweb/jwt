/**

Enumeration that describes the possible auth cookie prefix. 
        
<p>

Cookie prefixes are prefix that are added to the cookies name to enforce some rules on it. This allows to prevent some attacks where the attacker would try to update the cookies attribute.

<p>
@see AuthService#getAuthTokenCookiePrefix()
@see AuthService#getMfaTokenCookiePrefix()


        
*/
public enum AuthCookiePrefix {
  /** 
  
  No prefix. 
            
  */
  Empty,
  /** 
  
  __Secure- prefix 
            
  <p>
  
  This prefix ensure that the cookies has the Secure attribute set and ensure that the cookie is set by an HTTPS page.
  
  <p>
  This requires that the request was made over HTTPS.
  
  <p>
  
  
            
  */
  Secure,
  /** 
  
  __Host- prefix 
            
  <p>
  
  This prefix adds the same restriction as the __Secure- prefix with the addition that the cookie can only be sent to the host subdomain or domain that set it. It also enforces that the Domain atrribute is not set, and that the Path attribute is set to &quot;/&quot;.
  
  <p>
  @see AuthCookiePrefix#Secure
  
  
            
  */
  Host,
  /** 
  
  Automatically choose the prefix. 
            
  */
  Auto;
  
  /**
  Returns the numerical representation of this enum.
  */
  public int getValue() {
    return ordinal();
  }
}
