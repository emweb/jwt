  for ( int j =0; 
  j < colCount;++ j) {
     WLayoutItem  item =    this.grid_.items_.get(row).get(j).item_;
    if ( item != null) {
       int itemMaxHeight = getImpl (item).getMaximumHeight();
      if ( itemMaxHeight > 0) {
        if (isConstrained) {
          maxHeight = Math.min(maxHeight, itemMaxHeight);
}
        else  {
          maxHeight = itemMaxHeight;
isConstrained = true;
}
      }
    }
  }
  if (! isConstrained) {
    maxHeight = 0;
}
  return maxHeight;
