  public int getMinimumWidth() {
   final int colCount =    this.grid_.columns_.size ();
   int total =0;
  for ( int i =0; 
  i < colCount;++ i) {
    total +=   this.minimumWidthForColumn (i);
}
  return  total +   this.totalSpacing (Orientation.Horizontal);
  }
  public int getMinimumHeight() {
   final int rowCount =    this.grid_.rows_.size ();
   int total =0;
  for ( int i =0; 
  i < rowCount;++ i) {
    total +=   this.minimumHeightForRow (i);
}
  return  total +   this.totalSpacing (Orientation.Vertical);
  }
  public int getMaximumWidth() {
   final int colCount =    this.grid_.columns_.size ();
   int total =0;
  for ( int i =0; 
  i < colCount;++ i) {
     int colMax =  this.maximumWidthForColumn (i);
    if ( colMax == 0) {
      return 0;
    }
    total += colMax;
}
  return  total +   this.totalSpacing (Orientation.Horizontal);
  }
  public int getMaximumHeight() {
   final int rowCount =    this.grid_.rows_.size ();
   int total =0;
  for ( int i =0; 
  i < rowCount;++ i) {
     int rowMax =  this.maximumHeightForRow (i);
    if ( rowMax == 0) {
      return 0;
    }
    total += rowMax;
}
  return  total +   this.totalSpacing (Orientation.Vertical);
  }
