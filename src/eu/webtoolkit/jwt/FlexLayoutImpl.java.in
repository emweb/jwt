   static boolean hasContentSizingKeyword(WLayoutItem  item, Orientation orientation) {
   WWidget  widget = item.getWidget();
  if (! ( widget != null)) {
    return false;
  }
   final WLength size =  orientation == Orientation.Horizontal?  widget.getWidth():  widget.getHeight();
  return    size.getUnit() == LengthUnit.FitContent ||  size.getUnit() == LengthUnit.MaxContent ||  size.getUnit() == LengthUnit.MinContent;
  }
