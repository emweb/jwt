  private void setFromTimePicker() {
   boolean missingDate =   this.calendar_.getSelection().isEmpty();
   WDate date  =  missingDate? null:    this.calendar_.getSelection().iterator().next(); 
   this.setDateTime (new WDate(date,    this.timePicker_.getTime()));
if (! missingDate) {
      this.textInput ().trigger();
}
    this.changed ().trigger();
}
  private void setFromCalendar() {
  if (!    this.calendar_.getSelection().isEmpty()) { 
     this.setDateTime (new WDate(   this.calendar_.getSelection().iterator().next(),    this.timePicker_.getTime()));
  this.textInput ().trigger();
  this.changed ().trigger();
}
