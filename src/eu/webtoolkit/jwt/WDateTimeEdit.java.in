/** 

A Date and Time field editor. 
    
<p>

Wt/WDateTimeEdit.h

<p>
This editor is a line edit with support for a datetime entry. Users can fill in the datetime manually or rely on the popup. Using the icon of a calendar and clock.

<p>
In the popup a WTimePicker and {@link WCalendar} are shown to the user, allowing input in a more structured manner.

<p>

<p><i><b>Note: </b>The WTimePicker does not support timezones, and consequentially this widget doesn&apos;t either. If supplied, it is ignored.
</i></p>

@see eu.webtoolkit.jwt.WDate

@see WDateTimeValidator

@see WCalendar


    
*/
public class WDateTimeEdit extends WLineEdit {
  private static Logger logger = LoggerFactory.getLogger(WDateTimeEdit.class);
  
  /**
  
  Creates a new DateTimeEdit. 
          
  */
  public  WDateTimeEdit(WContainerWidget  parentContainer) {
  super ();
  this.uPopup_ = null;
  this.uCalendar_ = null;
  this.uTimePicker_ = null;
  this.customFormat_ = false;
  this.nativeControl_ = false;
    this.changed ().addListener(this, () -> {
  	WDateTimeEdit.this.setFromLineEdit();
  });
   this.uCalendar_=  new WCalendar();
  this.calendar_ =   this.uCalendar_;
    this.calendar_.setSingleClickSelect (true);
    this.calendar_.activated ().addListener(this, (WDate e1) -> {
  	WDateTimeEdit.this.setFocusTrue();
  });
    this.calendar_.selectionChanged ().addListener(this, () -> {
  	WDateTimeEdit.this.setFromCalendar();
  });
  this.setValidator (new WDateTimeValidator());
   this.uTimePicker_=  new WTimePicker(this);
  this.timePicker_ =   this.uTimePicker_;
    this.timePicker_.selectionChanged ().addListener(this, () -> {
  	WDateTimeEdit.this.setFromTimePicker();
  });
    this.timePicker_.setWrapAroundEnabled (true);
if (WWebWidget.isDefaultNativeControl()) { 
     this.setNativeControl (true);
}
  if ( parentContainer != null) parentContainer.addWidget (this);
}
  /** 
  
  Creates a new DateTimeEdit. 
          
  <p>Calls {@link #WDateTimeEdit(WContainerWidget  parentContainer) this((WContainerWidget)null)} */public  WDateTimeEdit()  {
    this((WContainerWidget)null);
  }
  public void  remove() {  
  this.calendar_ = null;
  this.timePicker_ = null;
super.remove();
  }
  /**
  
  Sets the date and time. 
          
  <p>
  
  Does nothing if the <code>dateTime</code> is <code>null</code>.
  
  <p>
  @see WDateTimeEdit#getDateTime()
  
  
          
  */
  public void setDateTime(final WDate dateTime) {
  if (! (dateTime==null)) { 
     this.setText ( dateTime.toString ( this.getFormat()));
if ((dateTime!=null)) {
       WDate date  = toDate (dateTime); 
         this.calendar_.select (date);
    this.calendar_.browseTo (date);
    this.timePicker_.setTime (dateTime.getTime());
}
  }
  }
  /**
  
  Returns the datetime. 
          
  <p>
  
  Reads the current datetime.
  
  <p>
  Returns <code>null</code> if the datetime could not be parsed using the current {@link WDateTimeEdit#getFormat() getFormat()}.
  
  <p>
  @see WDateTimeEdit#setDateTime(WDate dateTime)
  @see WLineEdit#getText()
  
  
          
  */
  public WDate getDateTime() {
  return WDate.fromString( this.getText(),  this.getFormat());
  }
  /**
  
  Returns the datetime validator. 
          
