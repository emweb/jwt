  */
  public WDateTimeValidator getDateTimeValidator() {
  return ObjectUtils.cast( super.getValidator(), WDateTimeValidator.class);
  }
  /**
  
  Configures whether a native HTML5 control should be used. 
          
  <p>
  
  When enabled, the browser&apos;s native datetime input (&lt;input type=&quot;datetime-local&quot;&gt;) will be used if available. This should provide a better experience on mobile browsers.
  
  <p>
  Setting native control to true limits the format to &quot;yyyy-MM-ddThh:mm&quot;.
  
  <p>
  There is no support for changing the native control after the widget is rendered.
  
  <p>
  By default, this is set to the value of {@link WWebWidget#isDefaultNativeControl()}.
  
  <p>
  @see WDateTimeEdit#isNativeControl()
  @see WDateTimeEdit#setFormat(String format)
  
  
          
  */
  public void setNativeControl(boolean nativeControl) { 
   this.setFormat (YMD_HMS_FORMAT);
  this.nativeControl_ = nativeControl;
}
  /**
  
  Returns whether a native HTML5 control is used, if supported. 
          
  <p>
  
  Taking into account the preference for a native control, configured using {@link WDateTimeEdit#setNativeControl(boolean nativeControl) setNativeControl()}, this method returns whether a native control is actually being used.
  
  <p>
  @see WDateTimeEdit#setNativeControl(boolean nativeControl)
  
  
          
  */
  public boolean isNativeControl() {
  return   this.nativeControl_;
  }
  /**
  
  Sets the format used for representing the datetime. 
          
  <p>
  
  This sets the format in the validator.
  
  <p>
  The default format is based on the current WLocale.
  
  <p>
  The format is set and limited to &quot;yyyy-MM-ddThh:mm&quot; when using the native HTML5 control. Changing to another format has no effect.
  
  <p>
  
  <p><i><b>Note: </b>The WTimePicker does not support timezones, and consequentially this widget doesn&apos;t either. If supplied, it is removed.
  </i></p>
  
  @see WDateTimeEdit#setNativeControl(boolean nativeControl)
  @see WDateTimeValidator#setFormat(String format)
  @see WDateTime#toString()
  @see WDate#toString()
  
  
          
  */
  public void setFormat(final String format) {
   WDateTimeValidator dtv  =  this.getDateTimeValidator();
   String formatStr  = format;
   int timeZoneIndex =formatStr.indexOf("Z");
  if ( timeZoneIndex != -1) {
    StringUtils.erase(formatStr, timeZoneIndex, 1);
logger.warn(new StringWriter().append("setFormat(): contains a timezone, which is omitted").toString());
}
  if ( dtv != null) {
    if (!  this.isNativeControl()) {
       WDate dt  =  this.getDateTime(); 
       dtv.setFormat (formatStr);
    this.timePicker_.configure ();
  this.setDateTime (dt);
  this.customFormat_ = true;
}
    else  {
      logger.warn(new StringWriter().append("setFormat() ignored since nativeControl() is true").toString());
}
  }
  else  {
    logger.warn(new StringWriter().append("setFormat(): ignored since validator is not a WDateTimeValidator").toString());
}
  }
  /**
  
  Returns the datetime format. 
          
  <p>
  
  @see WDateTimeEdit#setFormat(String format)
  
  
          
  */
  public String getFormat() {
   WDateTimeValidator dtv  =  this.getDateTimeValidator();
  if ( dtv != null) {
    return  dtv.getFormat();
  }
  else  {
    logger.warn(new StringWriter().append("format(): is bogus since validator is not a WDateTimeValidator").toString());
return "";
  }
  }
