  public void load() {
   boolean wasLoaded = this.isLoaded(); 
   super.load ();
if (wasLoaded) {
    return ;
  }
   WTemplate t  = new WTemplate(WString.tr ("Wt.WDateTimeEdit.popup"), (WContainerWidget)null);
   WTemplate  templ =t; 
   templ.addFunction ("tr", WTemplate.Functions.tr);
  templ.bindWidget ("calendar",   this.uCalendar_);
  templ.bindWidget ("timePicker",   this.uTimePicker_);
  this.uPopup_ = new WPopupWidget(t);
if (  this.isHidden ()) { 
       this.uPopup_.setHidden (true);
} 
     this.uPopup_.setAnchorWidget (this);
    this.uPopup_.setTransient (true);
  this.scheduleThemeStyleApply ( WApplication.getInstance().getTheme(),   this.uPopup_, WidgetThemeRole.DateTimePickerPopup);
  this.escapePressed ().addListener(  this.uPopup_, () -> {
  	WDateTimeEdit.this.uPopup_.hide();
  });
  this.escapePressed ().addListener(this, () -> {
  	WDateTimeEdit.this.setFocusTrue();
  });
}
  public void refresh() { 
   super.refresh ();
 WDateTimeValidator dtv = this.getDateTimeValidator();
  if ( !   this.customFormat_ &&  dtv != null) {
     WDate dt  =  this.getDateTime(); 
     dtv.setFormat (LocaleUtils.getDateTimeFormat(LocaleUtils.getCurrentLocale()));
  this.setDateTime (dt);
    this.timePicker_.configure ();
}
  }
  protected void render(EnumSet<RenderFlag> flags) {
  if ( flags.contains(RenderFlag.Full) && !  this.isNativeControl()) { 
     this.defineJavaScript ();
 WDateTimeValidator dtv  =  this.getDateTimeValidator();
    if ( dtv != null) { 
       this.setTop ( dtv.getTop());
  this.setBottom ( dtv.getBottom());
}
  } 
   super.render (flags);
}
  /**
  
  Sets the value from the line edit to the calenbdar and time picker. 
          
  */
  protected void setFromLineEdit() {
  if ( this.isNativeControl()) {
    return ;
  }
   WDate dt  = WDate.fromString( this.getText(),  this.getFormat());
   WTime t  = dt.getTime();
   WDate d  = toDate (dt);
  if ((t!=null && t.isValid())) { 
       this.timePicker_.setTime (t);
}
  if ((d!=null)) {
    if (   this.calendar_.getSelection().isEmpty()) { 
         this.calendar_.select (d);
    this.calendar_.selectionChanged ().trigger();
}
    else  {
       WDate j  =    this.calendar_.getSelection().iterator().next();
      if (! (j == d || (j != null && j.equals(d)))) { 
           this.calendar_.select (d);
    this.calendar_.selectionChanged ().trigger();
}
    } 
       this.calendar_.browseTo (d);
}
  }
   void updateDom(final DomElement element, boolean all) {
  if (  this.isNativeControl() &&   this.hasValidatorChanged ()) {
     WDateTimeValidator dtv = this.getDateTimeValidator();
    if ( dtv != null) {
       final WDate bottom = dtv.getBottom();
      if ((bottom!=null)) { 
        element.setAttribute ("min",  bottom.toString (YMD_HMS_FORMAT));
}
      else  { 
        element.removeAttribute ("min");
}
       final WDate top = dtv.getTop();
      if ((top!=null)) { 
        element.setAttribute ("max",  top.toString (YMD_HMS_FORMAT));
}
      else  { 
        element.removeAttribute ("max");
}
    }
  } 
   super.updateDom (element, all);
}
  protected void validatorChanged() {
   WDateTimeValidator dtv = this.getDateTimeValidator();
  if ( dtv != null) { 
       this.calendar_.setBottom (toDate ( dtv.getBottom()));
    this.calendar_.setTop ( dtv.getTop());
if ( this.isLoaded()) { 
         this.timePicker_.configure ();
}
  }
  else  {
    logger.warn(new StringWriter().append("Validator changed to a non-WDateTimeValidator. Several functions may not work correctly.").toString());
} 
   super.validatorChanged ();
}
