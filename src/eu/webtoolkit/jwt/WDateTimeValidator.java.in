/** 

A validator for dateTime input. 
    
<p>

This validator accepts input in the given dateTime format, and optionally checks if the dateTime is within a given range.

<p>
@see WDateTimeEdit

@see eu.webtoolkit.jwt.WDate


    
*/
public class WDateTimeValidator extends WValidator {
  private static Logger logger = LoggerFactory.getLogger(WDateTimeValidator.class);
  
  /**
  
  Creates a datetime validator. 
          
  <p>
  
  The validator will accept datetimes using the current locale&apos;s format. 
          
  */
  public  WDateTimeValidator() {
  super ();
  this.formats_ = new ArrayList<String>();
  this.bottom_ = null;
  this.top_ = null;
  this.tooEarlyText_ = new WString();
  this.tooLateText_ = new WString();
  this.notADateTimeText_ = new WString(); 
   this.setFormat (LocaleUtils.getDateTimeFormat(LocaleUtils.getCurrentLocale()));
}
  /**
  
  Creates a datetime validator. 
          
  <p>
  
  The validator will accept only datetimes within the indicated range <i>bottom</i> to <i>top</i>. 
          
  */
  public  WDateTimeValidator(final WDate bottom, final WDate top) {
  super ();
  this.formats_ = new ArrayList<String>();
  this.bottom_ = bottom;
  this.top_ = top;
  this.tooEarlyText_ = new WString();
  this.tooLateText_ = new WString();
  this.notADateTimeText_ = new WString(); 
   this.setFormat (LocaleUtils.getDateTimeFormat(LocaleUtils.getCurrentLocale()));
}
  /**
  
  Creates a datetime validator. 
          
  <p>
  
  The validator will accept dates in the date format <code>format</code>. 
          
  */
  public  WDateTimeValidator(final String format) {
  super ();
  this.formats_ = new ArrayList<String>();
  this.bottom_ = null;
  this.top_ = null;
  this.tooEarlyText_ = new WString();
  this.tooLateText_ = new WString();
  this.notADateTimeText_ = new WString(); 
   this.setFormat (format);
}
  /**
  
  Creates a datetime validator. 
          
  <p>
  
  The validator will accept only datetimes within the indicated range <i>bottom</i> to <i>top</i>, in the datetime format <code>format</code>. 
          
  */
  public  WDateTimeValidator(final String format, final WDate bottom, final WDate top) {
  super ();
  this.formats_ = new ArrayList<String>();
  this.bottom_ = bottom;
  this.top_ = top;
  this.tooEarlyText_ = new WString();
  this.tooLateText_ = new WString();
  this.notADateTimeText_ = new WString(); 
   this.setFormat (format);
}
  /**
  
  Sets the bottom of the valid datetime range. 
          
  <p>
  
  The default is an empty datetime constructed using WDateTime(). 
          
  */
  public void setBottom(final WDate bottom) {
  if (! (  this.bottom_ == bottom || (  this.bottom_ != null &&   this.bottom_.equals(bottom)))) { 
      this.bottom_=  bottom;
  this.repaint ();
}
  }
  /**
  
  Returns the bottom datetime of the valid range. 
          
  */
  public WDate getBottom() {
  return   this.bottom_;
  }
  /**
  
  Sets the top of the valid datetime range. 
          
  <p>
  
  The default is an empty datetime constructed using WDateTime::WDateTime(). 
          
  */
  public void setTop(final WDate top) {
  if (! (  this.top_ == top || (  this.top_ != null &&   this.top_.equals(top)))) { 
      this.top_=  top;
  this.repaint ();
}
  }
  /**
  
  Returns the top datetime of the valid range. 
          
  */
  public WDate getTop() {
  return   this.top_;
  }
  /**
  
  Sets the datetime format used to parse datetime strings. 
          
  <p>
  
  @see WDateTimeValidator#setFormats(List formats)
  
  
          
  */
  public void setFormat(final String format) {
   String formatStr  = format;
   int timeZoneIndex =formatStr.indexOf("Z");
  if ( timeZoneIndex != -1) {
    StringUtils.erase(formatStr, timeZoneIndex, 1);
logger.warn(new StringWriter().append("setFormat(): contains a timezone, which is omitted").toString());
}
  if (   this.formats_.isEmpty() || !   this.formats_.get(0).equals(formatStr)) { 
      this.formats_.clear ();
  this.formats_.add(formatStr);
  this.repaint ();
}
  }
  /**
  
  Returns the format string used to parse datetime strings. 
          
  <p>
  
  If multiple formats are specified, the first format in the list is returned.
  
  <p>
  @see WDateTimeValidator#setFormat(String format)
  
  
          
  */
  public String getFormat() {
  return   this.formats_.get(0);
  }
  /**
  
  Sets the datetime formats used to parse datetime strings. 
          
  <p>
  
  When multiple formats are given, the first format that correctly parses the input is used.
  
  <p>
  @see WDateTimeValidator#setFormat(String format)
  
  
          
  */
  public void setFormats(final List<String> formats) {
   List<String> filteredFormats  = new ArrayList<String>();
  for (String format :formats) {
     String formatStr  = format;
     int timeZoneIndex =formatStr.indexOf("Z");
    if ( timeZoneIndex != -1) {
      StringUtils.erase(formatStr, timeZoneIndex, 1);
logger.warn(new StringWriter().append("setFormats(): contains a timezone, which is omitted").toString());
}
    filteredFormats.add(formatStr);
}
  Utils.copyList(filteredFormats,   this.formats_);
  this.repaint ();
}
  /**
  
  Returns the datetime formats used to parse datetime strings. 
          
  */
  public List<String> getFormats() {
  return   this.formats_;
  }
  /**
  
  Validates the given input. 
          
  <p>
  
  The input is considered valid only when it is blank for a non-mandatory field, or represents a datetime in the given format, and within the valid range. 
          
  */
  public WValidator.Result validate(final String input) {
  if (input.length()==0) {
    return   super.validate (input);
  }
  for ( int i =0; 
  i <    this.formats_.size ();++ i) {
    try {
       WDate d  = WDate.fromString(input,   this.formats_.get(i));
      if ((d!=null)) {
        if ( ! (  this.bottom_==null) && d.before(  this.bottom_)) {
          return new WValidator.Result(ValidationState.Invalid,  this.getInvalidTooEarlyText());
        }
        if ( ! (  this.top_==null) && d.after(  this.top_)) {
          return new WValidator.Result(ValidationState.Invalid,  this.getInvalidTooLateText());
        }
        return new WValidator.Result(ValidationState.Valid);
      }
    }
    catch (final RuntimeException e ) {
      logger.warn(new StringWriter().append("validate(): ").append(e.toString()).toString());
}
  }
  return new WValidator.Result(ValidationState.Invalid,  this.getInvalidNotADateTimeText());
  }
  public String getJavaScriptValidate() {
  loadJavaScript (WApplication.getInstance());
 StringBuilder js  = new StringBuilder();
  js.append("new Wt4_15_0.WDateTimeValidator(").append(  this.isMandatory ()).append(",[");
for ( int i =0; 
  i <    this.formats_.size ();++ i) {
     WDate.RegExpInfo dateTimeRegex  = WDate.formatDateTimeToRegExp(  this.formats_.get(i));
    if ( i != 0) {
      js.append(',');
}
    js.append("{").append("regexp:").append(WWebWidget.jsStringLiteral ( dateTimeRegex.regexp)).append(',').append("getYear:function(results){").append( dateTimeRegex.yearGetJS).append(";},").append("getMonth:function(results){").append( dateTimeRegex.monthGetJS).append(";},").append("getDay:function(results){").append( dateTimeRegex.dayGetJS).append(";},").append("getHour:function(results){").append( dateTimeRegex.hourGetJS).append(";},").append("getMinutes:function(results){").append( dateTimeRegex.minuteGetJS).append(";},").append("getSeconds:function(results){").append( dateTimeRegex.secGetJS).append(";},").append("getMilliseconds:function(results){").append( dateTimeRegex.msecGetJS).append(";}").append("}");
}
  js.append("],");
if (! (  this.bottom_==null)) {
     WDate date  =   this.bottom_;
     WTime time  =   this.bottom_.getTime();
    js.append("new Date(").append(date.getYear()).append(',').append( date.getMonth() - 1).append(',').append(date.getDay()).append(',').append(time.getHour()).append(',').append(time.getMinute()).append(',').append(time.getSecond()).append(',').append(time.getMsec()).append(")");
}
  else  {
    js.append("null");
}
  js.append(',');
if (! (  this.top_==null)) {
     WDate date  =   this.top_;
     WTime time  =   this.top_.getTime();
    js.append("new Date(").append(date.getYear()).append(',').append( date.getMonth() - 1).append(',').append(date.getDay()).append(',').append(time.getHour()).append(',').append(time.getMinute()).append(',').append(time.getSecond()).append(',').append(time.getMsec()).append(")");
}
  else  {
    js.append("null");
}
  js.append(',').append(WString.toWString( this.getInvalidBlankText()).getJsStringLiteral()).append(',').append(WString.toWString( this.getInvalidNotADateTimeText()).getJsStringLiteral()).append(',').append(WString.toWString( this.getInvalidTooEarlyText()).getJsStringLiteral()).append(',').append(WString.toWString( this.getInvalidTooLateText()).getJsStringLiteral()).append(");");
return js.toString();
  }
  /**
  
  Sets the message to display when the input is not a datetime. 
          
  <p>
  
  The default message is &quot;The date and time must match the format {1}&quot;, with the format string as the first argument. 
          
  */
  public void setInvalidNotADateTimeText(final CharSequence text) {
    this.notADateTimeText_ = WString.toWString(text);
}
  /**
  
  Returns the message displayed when the input is not a datetime. 
          
  <p>
  
  @see WDateTimeValidator#setInvalidNotADateTimeText(CharSequence text)
  
  
          
  */
  public WString getInvalidNotADateTimeText() {
  if (! (  this.notADateTimeText_.length()==0)) {
     WString s  =   this.notADateTimeText_; 
    s.arg (  this.formats_.get(0));
return s;
  }
  else  {
    return  WString.tr ("Wt.WDateTimeValidator.WrongFormat").arg (  this.formats_.get(0));
  }
  }
  /**
  
  Sets the message to display when the datetime is earlier than {@link WDateTimeValidator#getBottom() getBottom()}. 
          
  <p>
  
  The default message is &quot;The date and time must be between
  {1} and {2}&quot; or &quot;The date and time must be after {1}&quot;. 
          
  */
  public void setInvalidTooEarlyText(final CharSequence text) {
    this.tooEarlyText_ = WString.toWString(text);
  this.repaint ();
}
  /**
  
  Returns the message displayed when datetime is too early. 
          
  <p>
  
  @see WDateTimeValidator#setInvalidTooEarlyText(CharSequence text)
  
  
          
  */
  public WString getInvalidTooEarlyText() {
  if (! (  this.tooEarlyText_.length()==0)) {
     WString s  =   this.tooEarlyText_; 
     s.arg (   this.bottom_.toString (  this.formats_.get(0))).arg (   this.top_.toString (  this.formats_.get(0)));
return s;
  }
  else  {
    if (  (  this.tooEarlyText_.length()==0) && ! (  this.bottom_==null) && ! (  this.top_==null)) {
      return   WString.tr ("Wt.WDateTimeValidator.WrongDateTimeRange").arg (   this.bottom_.toString (  this.formats_.get(0))).arg (   this.top_.toString (  this.formats_.get(0)));
    }
    else  {
      if ( (  this.tooEarlyText_.length()==0) && ! (  this.bottom_==null)) {
        return  WString.tr ("Wt.WDateTimeValidator.DateTimeTooEarly").arg (   this.bottom_.toString (  this.formats_.get(0)));
      }
      else  {
        return new WString();
      }
    }
  }
  }
  /**
  
  Sets the message to display when the datetime is later than {@link WDateTimeValidator#getTop() getTop()}. 
          
  <p>
  
  Depending on whether {@link WDateTimeValidator#getBottom() getBottom()} and {@link WDateTimeValidator#getTop() getTop()} are defined, the default message is. &quot;The date and time must be between
  {1} and {2}&quot; or &quot;The date and time must be before {2}&quot;. 
          
  */
  public void setInvalidTooLateText(final CharSequence text) {
    this.tooLateText_ = WString.toWString(text);
  this.repaint ();
}
  /**
  
  Returns the message displayed when the datetime is too late. 
          
  <p>
  
  @see WDateTimeValidator#setInvalidTooLateText(CharSequence text)
  
  
          
  */
  public WString getInvalidTooLateText() {
  if (! (  this.tooLateText_.length()==0)) {
     WString s  =   this.tooLateText_; 
     s.arg (   this.bottom_.toString (  this.formats_.get(0))).arg (   this.top_.toString (  this.formats_.get(0)));
return s;
  }
  else  {
    if (  (  this.tooLateText_.length()==0) && ! (  this.top_==null) && ! (  this.bottom_==null)) {
      return   WString.tr ("Wt.WDateTimeValidator.WrongDateTimeRange").arg (   this.bottom_.toString (  this.formats_.get(0))).arg (   this.top_.toString (  this.formats_.get(0)));
    }
    else  {
      if ( (  this.tooLateText_.length()==0) && ! (  this.top_==null)) {
        return  WString.tr ("Wt.WDateTimeValidator.DateTimeTooLate").arg (   this.top_.toString (  this.formats_.get(0)));
      }
      else  {
        return new WString();
      }
    }
  }
  }
  private List<String> formats_ ;
  private WDate bottom_ ;
  private WDate top_ ;
  private WString tooEarlyText_ ;
  private WString tooLateText_ ;
  private WString notADateTimeText_ ;
